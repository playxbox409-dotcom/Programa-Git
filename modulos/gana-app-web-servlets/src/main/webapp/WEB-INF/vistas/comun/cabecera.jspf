<header class="encabezado">
    <div class="marca">
        <img class="marca__logo"
             src="${pageContext.request.contextPath}/img/logo_gana_app.png"
             alt="Logo de GANA APP">
        <div>
            <strong>GANA APP</strong>
            <small>Gesti&oacute;n y comercializaci&oacute;n ganadera</small>
        </div>
    </div>
    <nav aria-label="Navegación principal">
        <a href="${pageContext.request.contextPath}/animales">Animales</a>
        <a href="${pageContext.request.contextPath}/animales?accion=nuevo">Registrar</a>
    </nav>
</header>
